# Set secrets only in the hosting provider runtime settings. Do not commit .env.
NODE_ENV=production
PORT=3000
# Optional; recommended after you know your final HTTPS domain:
# PUBLIC_ORIGIN=https://your-service.example.com
COOKIE_SECURE=1
AI_MODE=off
AI_MODEL=YOUR_MODEL
GAPGPT_API_KEY=YOUR_PRIVATE_KEY
# For AI_MODE=live configure pricing and budget limits as appropriate.
